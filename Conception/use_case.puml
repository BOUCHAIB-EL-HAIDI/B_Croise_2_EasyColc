@startuml EasyColoc Use Case Diagram

skinparam actorStyle awesome
left to right direction

' --- Hiérarchie des Acteurs ---
actor "Utilisateur Authentifié" as User
actor "Colocataire (Commun)" as Colocataire
actor "Membre (Régulier)" as Member
actor "Propriétaire (Créateur)" as Owner
actor "Admin Global (Super)" as Admin

' Logique d'héritage
Colocataire --|> User
Member --|> Colocataire
Owner --|> Colocataire

' L'Admin est un super-utilisateur qui peut agir partout
Admin --|> Owner
Admin --|> Member

rectangle "EasyColoc Platform" {
    package "Accès Système" {
        usecase "Accepter / Refuser une invitation" as UC16
        usecase "Créer une colocation" as UC9
    }
    
    package "Vie en Colocation (Actions Communes)" {
        usecase "Ajouter une dépense" as UC5
        usecase "Supprimer ses propres dépenses" as UC6
        usecase "Voir les membres & réputation" as UC20
        usecase "Filtrer/Voir dépenses & stats" as UC21
        usecase "Voir le détail des soldes" as UC23
        usecase "Déclarer un paiement" as UC7
        usecase "Confirmer un paiement" as UC8
    }
    
    package "Droits Exclusifs Membre" {
        usecase "Quitter la colocation" as UC4
    }
    
    package "Administration de Coloc (Owner)" {
        usecase "Inviter des colocataires & Suivi" as UC10
        usecase "Retirer un membre" as UC11
        usecase "Gérer les catégories" as UC12
        usecase "Annuler / Supprimer la colocation" as UC17
    }
    
    package "Supervision Système (Admin Global)" {
        usecase "Dashboard Admin Global" as UC13
        usecase "Bannir / Débannir utilisateur" as UC14
        usecase "Voir statistiques globales" as UC15
    }
}

' Liaisons
User --> UC16
User --> UC9

Colocataire --> UC5
Colocataire --> UC6
Colocataire --> UC7
Colocataire --> UC8
Colocataire --> UC20
Colocataire --> UC21
Colocataire --> UC23

Member --> UC4

Owner --> UC10
Owner --> UC11
Owner --> UC12
Owner --> UC17

Admin --> UC13
Admin --> UC14
Admin --> UC15

@enduml
